rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }
    function createIsOwner() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }
    // The immutable ownership field can never be reassigned on update — this
    // stops a member handing their record to (or planting one under) another
    // user's id, and blocks parameter-tampering / mass-assignment on userId.
    function ownerUnchanged() {
      return request.resource.data.userId == resource.data.userId;
    }

    // Deterministic connection id for the (me, other) pair, sorted so both
    // members resolve to the same document.
    function connId(other) {
      return request.auth.uid < other
        ? request.auth.uid + '__' + other
        : other + '__' + request.auth.uid;
    }
    function isFriendOf(ownerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/connections/$(connId(ownerId)))
        && get(/databases/$(database)/documents/connections/$(connId(ownerId))).data.status == 'accepted';
    }
    // Owner always; an accepted friend may read.
    function sharedRead(ownerId) {
      return signedIn() && (ownerId == request.auth.uid || isFriendOf(ownerId));
    }

    match /places/{placeId} {
      allow read: if sharedRead(resource.data.userId);
      allow create: if createIsOwner();
      allow update: if isOwner() && ownerUnchanged();
      allow delete: if isOwner();
    }

    match /discoveries/{discoveryId} {
      allow read: if sharedRead(resource.data.userId);
      allow create: if createIsOwner();
      allow update: if isOwner() && ownerUnchanged();
      allow delete: if isOwner();
    }

    // Trips (recorded past journeys AND planned upcoming trips share this one
    // collection). Readable by accepted friends (powers Circle's "on the move")
    // OR by an invited crew member. Any crew member may edit the shared content,
    // but ownership is immutable and only the owner controls the crew — a
    // collaborator may only remove themselves. Legacy expeditions have no
    // memberIds; the owner branch keeps them owner-editable exactly as before.
    match /expeditions/{expeditionId} {
      function crewMember() {
        return signedIn() && (
          resource.data.userId == request.auth.uid
          || (resource.data.memberIds is list && request.auth.uid in resource.data.memberIds)
        );
      }
      allow read: if sharedRead(resource.data.userId) || crewMember();
      allow create: if createIsOwner();
      allow update: if crewMember()
        && request.resource.data.userId == resource.data.userId
        && (
          resource.data.userId == request.auth.uid
          || request.resource.data.memberIds == resource.data.memberIds
          || (
            !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.memberIds.hasOnly(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          )
        );
      allow delete: if isOwner();
    }

    // Photo captures are readable by accepted friends (Circle "snaps").
    match /captures/{captureId} {
      allow read: if sharedRead(resource.data.userId);
      allow create: if createIsOwner();
      allow update: if isOwner() && ownerUnchanged();
      allow delete: if isOwner();
    }

    // A capture is visible to you if you own it or an accepted friend owns it —
    // the same gate as reading the capture itself. Used to scope likes/replies
    // so their text and counts can't be enumerated for content you can't see.
    function captureVisible(captureId) {
      return captureId is string
        && exists(/databases/$(database)/documents/captures/$(captureId))
        && sharedRead(get(/databases/$(database)/documents/captures/$(captureId)).data.userId);
    }

    // Likes on a capture. The doc id is `${captureId}__${likerUid}` so each
    // member can like a capture once. Readable only by members who can see the
    // underlying capture (owner or accepted friend), never enumerable globally.
    match /likes/{likeId} {
      // Readable by anyone who can see the underlying capture, OR by the author
      // of the like (so a member can enumerate + delete their own on account
      // deletion, even for captures they can no longer see).
      allow read: if signedIn()
        && (captureVisible(resource.data.captureId) || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && likeId == request.resource.data.captureId + '__' + request.auth.uid
        && captureVisible(request.resource.data.captureId);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // One-line replies on a capture. Readable only by members who can see the
    // underlying capture; authors write their own, short, text on captures they
    // are allowed to view.
    match /replies/{replyId} {
      // Readable by anyone who can see the underlying capture, OR by the author
      // (so a member can enumerate + delete their own replies on account
      // deletion — their name and text must not outlive their account).
      allow read: if signedIn()
        && (captureVisible(resource.data.captureId) || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.captureId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && captureVisible(request.resource.data.captureId);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Saved bookmarks stay private to their owner.
    match /saved/{savedId} {
      allow read, delete: if isOwner();
      allow update: if isOwner() && ownerUnchanged();
      allow create: if createIsOwner();
    }

    // Planned trips: the owner, plus any friend invited to collaborate
    // (listed in memberIds), may read and edit the shared itinerary. Only the
    // owner may delete or change the crew. The userId fallback keeps
    // pre-collaboration trips valid.
    match /trips/{tripId} {
      function tripMember() {
        return signedIn() && (
          resource.data.userId == request.auth.uid
          || (resource.data.memberIds is list && request.auth.uid in resource.data.memberIds)
        );
      }
      allow read: if tripMember();
      // Any member may edit the itinerary, but ownership is immutable. The owner
      // has full control of the crew (memberIds); a collaborator may only leave
      // (remove exactly themselves) — never seize the trip, evict others, or
      // add strangers.
      allow update: if tripMember()
        && request.resource.data.userId == resource.data.userId
        && (
          resource.data.userId == request.auth.uid
          || request.resource.data.memberIds == resource.data.memberIds
          || (
            !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.memberIds.hasOnly(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          )
        );
      allow delete: if isOwner();
      allow create: if createIsOwner();
    }

    // Custom country cover photos stay private to their owner.
    match /covers/{coverId} {
      allow read, delete: if isOwner();
      allow update: if isOwner() && ownerUnchanged();
      allow create: if createIsOwner();
    }

    // Member profile, looked up by uid once you're connected. No listing.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid;
      // Owner may delete their own profile (used by in-app account deletion).
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // code -> uid resolver, fetched by exact id only (no enumeration).
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Friendships / requests between exactly two members.
    match /connections/{id} {
      // `resource` is null when the doc doesn't exist yet — allow the read so
      // the client can check "is there already a request?" before creating one.
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.members);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.members.size() == 2;
      // Only the *recipient* (not the requester) may update — i.e. accept a
      // pending request — and the membership/requester fields can't be changed.
      // This stops a requester from accepting their own request.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.members == resource.data.members
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // Per-device push token + friend-activity preference. Written by its owner;
    // read only by Cloud Functions (admin SDK bypasses rules), never by clients.
    match /pushTokens/{uid} {
      allow read: if false;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Internal per-author notification cooldown — Cloud Functions only.
    match /activityThrottle/{uid} {
      allow read, write: if false;
    }

    // Moderation reports (Guideline 1.2). Any signed-in member may flag content
    // or another member; reports are write-only from the client and read only by
    // the moderation team (Admin SDK / console), never by other users.
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Blocks. A member records the accounts they've blocked; only they can read
    // or manage their own block records.
    match /blocks/{id} {
      allow read: if signedIn() && resource.data.blocker == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.blocker == request.auth.uid
        && id == request.auth.uid + '__' + request.resource.data.blocked;
      allow delete: if signedIn() && resource.data.blocker == request.auth.uid;
      allow update: if false;
    }

    // Per-user, per-day AI usage counter enforcing the Historian quota. The doc
    // id is `${uid}_${yyyymmdd}`, so it resets daily. It is tamper-resistant:
    // a member can only create it at 1 or increment it by exactly 1, and can
    // never reset or decrement it — so the server-side daily cap can't be
    // evaded from the client. Written server-side with the caller's token.
    match /aiUsage/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == 1;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }
  }
}
